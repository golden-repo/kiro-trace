# .env.example
#
# Documents every environment variable this app understands. This
# project ships two real files derived from this template:
#   - .env.development  (loaded by default; ENVIRONMENT unset or "development")
#   - .env               (loaded when ENVIRONMENT=production)
# Both are read automatically at startup via python-dotenv -- see
# app/config.py. Real exported environment variables / docker -e /
# Kubernetes env: always take priority over values from either file.
#
# Do NOT commit a real ".env" or ".env.development" file with real
# secrets to version control (both are already in .gitignore). This
# .env.example file only contains placeholder/example values and is
# safe to commit.

# development or production -- selects .env.development vs .env (see above).
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Redis connection (the Redis instance running in the "redis" namespace,
# reachable at localhost:6379 from the developer's machine; when this app
# runs inside a container/Pod, point REDIS_HOST at whatever hostname
# reaches that Redis from inside the cluster instead, e.g.
# "redis.redis.svc.cluster.local")
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=redis123
REDIS_DB=0
REDIS_USE_TLS=false

# How long (seconds) telemetry records live in Redis before auto-expiring.
# 604800 seconds = 7 days.
TELEMETRY_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# API security -- every request to /api/* must send this exact value in
# the "X-API-Key" header. REPLACE this with a real random secret before
# using this anywhere beyond your own local testing.
# You can generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
API_KEY=replace-this-with-a-real-random-secret

# ---------------------------------------------------------------------------
# Web server bind address/port (defaults shown are also the Dockerfile's
# EXPOSE'd port).
# ---------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000

# Set to "true" for more verbose logging while developing locally.
DEBUG=false
